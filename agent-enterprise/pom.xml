<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://www.w3.org/2000/XSD https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.qwzhang01</groupId>
        <artifactId>seven-agent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-enterprise</artifactId>
    <name>Agent Enterprise</name>
    <description>Enterprise Agent Profile (Stage 15): tenant &amp; user identity, tenant-scoped
        knowledge (RAG), role-based governance wiring, cost ledger, business tasks with
        approval &amp; resume. First domain profile on the shared Runtime.</description>

    <dependencies>
        <!-- Dependencies are added as milestones land ("add when used" discipline):
             M15.1: agent-memory (MemoryScope / MemoryStore).
             M15.2: agent-core (Tool interface for KnowledgeTool).
             M15.3: agent-security (PermissionChecker extension point / AuditLogger /
             Governance chain wiring).
             M15.4: agent-workflow (RunManager / HumanApprovalNode / task resume). -->
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-model</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
