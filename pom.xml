                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.qwzhang01</groupId>
                <artifactId>agent-sandbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.qwzhang01</groupId>
