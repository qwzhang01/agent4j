    <groupId>io.github.qwzhang01</groupId>
    <artifactId>seven-agent</artifactId>
    <version>0.1.4</version>
    <packaging>pom</packaging>
    <name>Java Agent Framework</name>
    <description>A persistent, observable, governable, hot-pluggable Java Agent Runtime</description>
    <url>https://github.com/qwzhang01/agent4j</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>qwzhang01</id>
            <name>qwzhang01</name>
            <url>https://github.com/qwzhang01</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:qwzhang01/agent4j.git</connection>
        <developerConnection>scm:git:git@github.com:qwzhang01/agent4j.git</developerConnection>
        <url>https://github.com/qwzhang01/agent4j</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/qwzhang01/agent4j/issues</url>
    </issueManagement>

    <modules>
        <module>seven-agent-bom</module>
        <module>agent-core</module>
        <module>agent-model</module>
        <module>agent-plugin</module>
        <module>agent-sandbox</module>
        <module>agent-workflow</module>
        <module>agent-scheduler</module>
        <module>agent-memory</module>
        <module>agent-security</module>
        <module>agent-mcp</module>
        <module>agent-orchestrator</module>
        <module>agent-channel</module>
        <module>agent-product</module>
        <module>agent-trace-export</module>
        <module>agent-enterprise</module>
        <module>agent-tavern</module>
