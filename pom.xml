    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jackson.version>2.17.2</jackson.version>
        <slf4j.version>2.0.13</slf4j.version>
        <lombok.version>1.18.34</lombok.version>
        <junit.version>5.10.3</junit.version>
        <opentelemetry.version>1.44.1</opentelemetry.version>
        <h2.version>2.2.224</h2.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
        <!-- Daily CI stays green if javadoc is noisy; release profile flips this to true. -->
        <javadoc.failOnError>false</javadoc.failOnError>
        <!-- false: `mvn deploy` uploads. Set true only for a local-only dry run. -->
        <skip.central.publish>false</skip.central.publish>
        <central.serverId>avinzhang-opensource</central.serverId>
        <agent4j.version>0.1.4</agent4j.version>
        <!-- Stage 8.3: default surefire tag exclusion (transport/DB ITs are opt-in).
             CI opens them by clearing the exclusion and selecting the tag:
             -Dagent4j.surefire.excludedGroups= -Dgroups=postgres
             (other profiles: mcp-it, a2a-it — see docs/harness-contract.md). -->
        <agent4j.surefire.excludedGroups>postgres,mcp-it,a2a-it</agent4j.surefire.excludedGroups>
        <!-- Stage 8.3: coverage floor defaults (measured 2026-09-16, 20 modules:
             lowest line 63% / branch 49%). Anti-regression floor, not a target:
             floors sit below current reality so the build is green by
             construction; per-module override possible in module poms. -->
        <agent4j.jacoco.line.min>0.60</agent4j.jacoco.line.min>
        <agent4j.jacoco.branch.min>0.40</agent4j.jacoco.branch.min>
    </properties>

