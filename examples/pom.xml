<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.qwzhang01</groupId>
        <artifactId>seven-agent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>examples</artifactId>
    <name>Agent Framework Examples</name>
    <description>Example agents and usage demos</description>

    <properties>
        <!-- Demo module only. central-publishing-maven-plugin ignores maven.deploy.skip
             and uploads one bundle from the last reactor module; do NOT set
             skipPublishing here (examples is last and would drop the whole upload).
             Parent release profile excludeArtifacts=examples is the real gate. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-model</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-plugin</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-sandbox</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-orchestrator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-channel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-product</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-trace-export</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-enterprise</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-tavern</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-coding</artifactId>
        </dependency>
        <!-- Stage 18: ObservabilityExample (metrics / budget / routing / eval / version glue). -->
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
            </plugin>
        </plugins>
    </build>
</project>
