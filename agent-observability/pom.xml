<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.qwzhang01</groupId>
        <artifactId>seven-agent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>agent-observability</artifactId>
    <name>Agent Observability</name>
    <description>Observability &amp; cost governance (Stage 18, final stage of the 18-week plan):
        boundary-captured metrics, multi-dimensional budgets, explainable model routing, evaluation
        regression, version provenance. Metrics live at the decorator boundary, not in the loop path
        (blueprint D2); one run, three projections - Trajectory (training, Stage 14) / AuditEvent
        (governance, Stage 9) / Metrics (operations, Stage 18) share the same boundaries (blueprint D1).</description>

    <dependencies>
        <!-- Dependencies are added as milestones land ("add when used" discipline):
             M18.1: agent-core (ModelClient/ToolExecutor contracts, TokenUsage, AgentState.Status).
             M18.4: agent-trace-export (EvalDataset imports failure trajectories). -->
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <!-- M18.4: EvalDataset imports failure trajectories (Trajectory / DoneReason). -->
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-trace-export</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-model</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
