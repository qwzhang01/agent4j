                   blueprint D5: reuse the Stage 4 data contracts, re-implement the process
                   pattern - the temp-dir isolation model is deliberately NOT reused).
             M17.5: agent-security (governance chain, approval + audit - the D8 permission
                   tiers and the REQUIRES_APPROVAL gates for run_command/run_tests). -->
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-sandbox</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-model</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
