<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.qwzhang01</groupId>
        <artifactId>seven-agent</artifactId>
        <version>0.1.4</version>
    </parent>

    <artifactId>agent-scheduler</artifactId>
    <name>Agent Scheduler</name>
    <description>Async task scheduler: scheduled resume, event-driven resume, async task queue</description>

    <dependencies>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-model</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Stage 8.3: real-PostgreSQL dialect proof for the task queue.
             Test scope only: the framework binds no database driver. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Postgres ITs are opt-in: -Dgroups=postgres with a
                         reachable DB; skipped by assumption otherwise.
                         Parametrized so CI can clear the exclusion:
                         -Dagent4j.surefire.excludedGroups= -Dgroups=postgres -->
                    <excludedGroups>${agent4j.surefire.excludedGroups}</excludedGroups>
                    <!-- Surefire's default scan patterns (*Test/*Tests/...) do
                         not cover *IT classes; adopt them explicitly so the
                         postgres profile can select them by tag. -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
