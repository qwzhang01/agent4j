<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.qwzhang01</groupId>
        <artifactId>seven-agent</artifactId>
        <version>0.1.5-SNAPSHOT</version>
    </parent>

    <artifactId>agent-workflow</artifactId>
    <name>Agent Workflow</name>
    <description>Workflow graph engine: deterministic control plane over agent nodes</description>

    <dependencies>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.qwzhang01</groupId>
            <artifactId>agent-model</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Stage 8.3: real-PostgreSQL dialect proof (postgres-tagged ITs).
             Test scope only: the framework binds no database driver at
             runtime; H2/PG live exclusively in test JVMs. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Default run: postgres ITs are opt-in (-Dgroups=postgres
                         + reachable DB). CI runs them with the profile on;
                         a developer machine without PG sees them skipped
                         by assumption, not silently passing.
                         Parametrized so CI can clear the exclusion:
                         -Dagent4j.surefire.excludedGroups= -Dgroups=postgres -->
                    <excludedGroups>${agent4j.surefire.excludedGroups}</excludedGroups>
                    <!-- Surefire's default scan patterns (*Test/*Tests/...) do
                         not cover *IT classes; adopt them explicitly so the
                         postgres profile can select them by tag. -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
